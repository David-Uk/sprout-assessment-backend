# Copy to .env and fill in with your own values. Placeholder values only — never commit real secrets.
# README section 2 explains how to create a Neon account/database and obtain each connection string.
# .env.local is loaded before .env and wins when both exist.

# Runtime
NODE_ENV=development
PORT=3000

# Neon (recommended):
#   DATABASE_URL         = POOLED string (hostname contains "-pooler") for app queries + /health
#   DATABASE_URL_UNPOOLED = DIRECT string (no "-pooler") for db:init / db:seed migrations
# Get both from the Neon Console -> Connect, or `neon connection-string [--pooled]`.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Tests must use a separate Neon branch. Copy .env.test.example to .env.test for its URLs;
# this local value is only a fallback for local Docker setup.
DATABASE_URL_TEST=postgresql://sprout:changeme@localhost:5432/sprout_tasks_test
DB_SSL=false
DB_POOL_MAX=10

# Local PostgreSQL container (docker-compose.yml) — use these ONLY if you are not using Neon.
POSTGRES_USER=sprout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sprout_tasks
DB_PORT=5432

# Allowed frontend origin(s), comma-separated. Never use "*" in production.
# In development only, any http://localhost:<port> or http://127.0.0.1:<port>
# is also allowed, since Vite moves to the next free port when 5173 is busy.
CORS_ORIGIN=http://localhost:5173

# Observability / security tuning (currently informational; config.js uses fixed values)
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
