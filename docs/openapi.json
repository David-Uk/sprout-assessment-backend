{
  "openapi": "3.1.0",
  "info": {
    "title": "Task Manager API",
    "version": "1.0.0",
    "description": "Express REST API for the Task Management App, backed by Neon Lakebase Postgres. Tasks have a title, optional description and a status of pending, in_progress or completed."
  },
  "servers": [{ "url": "/", "description": "This server" }],
  "tags": [
    { "name": "Health", "description": "Liveness and database readiness" },
    { "name": "Tasks", "description": "Create, list and update tasks" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns the API status and whether the database query succeeded.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": { "status": "ok", "database": true }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "description": "Returns tasks newest first, with optional status filtering and pagination.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only return tasks with this status.",
            "schema": { "$ref": "#/components/schemas/Status" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page number.",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Items per page (1-100).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tasks",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a task",
        "description": "Creates a task and returns the created row.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" },
              "examples": {
                "minimal": { "value": { "title": "Write README" } },
                "full": {
                  "value": {
                    "title": "Design schema",
                    "description": "Define the tasks table",
                    "status": "in_progress"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/tasks/{id}/status": {
      "patch": {
        "tags": ["Tasks"],
        "summary": "Update a task's status",
        "description": "Any status can transition to any other status. Returns the updated task.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Positive integer task id.",
            "schema": { "type": "integer", "minimum": 1 },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateStatusRequest" },
              "example": { "status": "completed" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "string",
        "enum": ["pending", "in_progress", "completed"],
        "description": "Allowed task statuses."
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "Generated task id." },
          "title": { "type": "string", "maxLength": 150, "description": "Task title (trimmed)." },
          "description": { "type": "string", "maxLength": 1000, "description": "Optional details; empty string when omitted." },
          "status": { "$ref": "#/components/schemas/Status" },
          "created_at": { "type": "string", "format": "date-time", "description": "UTC timestamp set by the database." },
          "updated_at": { "type": "string", "format": "date-time", "description": "UTC timestamp of the last status change." }
        },
        "required": ["id", "title", "description", "status", "created_at"]
      },
      "CreateTaskRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 150, "description": "Required, trimmed, 1-150 characters." },
          "description": { "type": "string", "maxLength": 1000, "default": "", "description": "Optional, at most 1000 characters." },
          "status": { "allOf": [{ "$ref": "#/components/schemas/Status" }], "default": "pending" }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": { "status": { "$ref": "#/components/schemas/Status" } },
        "required": ["status"],
        "additionalProperties": false
      },
      "TaskResponse": {
        "type": "object",
        "properties": { "data": { "$ref": "#/components/schemas/Task" } },
        "required": ["data"]
      },
      "TaskList": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "count": { "type": "integer", "description": "Items in this page." },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer", "description": "Total matching tasks." }
        },
        "required": ["data", "count", "page", "limit", "total"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "database": { "type": "boolean", "description": "True when SELECT 1 succeeded." }
        },
        "required": ["status", "database"]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["VALIDATION_ERROR", "NOT_FOUND", "FORBIDDEN", "RATE_LIMITED", "INTERNAL_ERROR"]
          },
          "message": { "type": "string" },
          "details": {
            "type": "array",
            "description": "Optional field-level details for validation errors.",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "required": ["code", "message"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "$ref": "#/components/schemas/ErrorBody" } },
        "required": ["error"]
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid body, params or query",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": { "code": "VALIDATION_ERROR", "message": "Invalid title" } }
          }
        }
      },
      "NotFound": {
        "description": "No task with that id",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": { "code": "NOT_FOUND", "message": "Task not found" } }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server failure",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "error": { "code": "INTERNAL_ERROR", "message": "Internal server error" } }
          }
        }
      }
    }
  }
}
