# Copy to .env and adjust locally. Placeholder values only — never commit real secrets.

# Runtime
NODE_ENV=development
PORT=3000

# Application database connection (matches the docker-compose.yml defaults)
DATABASE_URL=postgresql://sprout:changeme@localhost:5432/sprout_tasks
DATABASE_URL_UNPOOLED=postgresql://sprout:changeme@localhost:5432/sprout_tasks
DATABASE_URL_TEST=postgresql://sprout:changeme@localhost:5432/sprout_tasks_test
DB_SSL=false
DB_POOL_MAX=10

# Local PostgreSQL container (docker-compose.yml)
POSTGRES_USER=sprout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sprout_tasks
DB_PORT=5432

# Allowed frontend origin(s), comma-separated. Never use "*" in production.
CORS_ORIGIN=http://localhost:5173

# Observability / security tuning
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
