# Copy to .env.test using the connection strings of a dedicated Neon `test` branch.
# Create it with: neon branches create --name test --parent production --no-secrets
# Then, from the Neon Console -> Connect (branch = test):
#   pooled  (Connection pooling ON, hostname contains "-pooler") -> DATABASE_URL_TEST
#   direct  (Connection pooling OFF, no "-pooler")               -> DATABASE_URL_TEST_UNPOOLED
# CLI equivalents:
#   neon connection-string test --pooled
#   neon connection-string test
# Never point these at the production branch — the suite truncates the tasks table.
NODE_ENV=test
DATABASE_URL_TEST=postgresql://user:password@ep-example-test-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_TEST_UNPOOLED=postgresql://user:password@ep-example-test.region.aws.neon.tech/neondb?sslmode=require
